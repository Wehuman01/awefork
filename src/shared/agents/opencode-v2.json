{
  "kind": "opencode",
  "protocol": "v2",
  "compat": { "min": "2.0.0", "max": "2.1.0" },
  "capabilities": { "deleteMessage": false, "attachments": true, "compress": true },
  "fork": { "cut": "next-user-exclusive", "cutParam": "before" },
  "auth": { "scheme": "basic", "username": "opencode" },
  "envelope": { "dataKey": "data", "bare": ["projects"] },
  "pagination": {
    "style": "cursor",
    "limitParam": "limit",
    "cursorParam": "cursor",
    "nextPath": "cursor.next",
    "limit": 200,
    "limits": { "sessions": 2000, "sessionMessages": 200 },
    "order": "asc"
  },
  "prompt": {
    "style": "text",
    "modelInBody": false,
    "fileEncoding": "data-url-uri",
    "setModelFirst": true
  },
  "fileChanges": {
    "tools": ["edit", "write"],
    "filePathPaths": ["input.path", "input.filePath"],
    "doneStates": ["completed", "error"]
  },
  "sessions": {
    "create": { "directoryIn": "body" },
    "fields": {
      "id": ["id"],
      "title": ["title"],
      "directory": ["location.directory"],
      "parentSessionId": ["parentID"],
      "forkSessionId": ["fork.sessionID"],
      "createdAt": ["time.created"],
      "updatedAt": ["time.updated"]
    }
  },
  "messages": {
    "partsPath": "content",
    "textPath": ["text"],
    "attachments": {
      "path": "files",
      "nameField": "name",
      "mimeField": "mime",
      "dataField": "data"
    },
    "fields": {
      "id": ["id"],
      "role": ["type"],
      "modelId": ["model.id"],
      "providerId": ["model.providerID"],
      "variant": ["model.variant"],
      "createdAt": ["time.created"],
      "completedAt": ["time.completed"],
      "finish": ["finish"],
      "outputTokens": ["tokens.output"],
      "error": ["error.message", "error.type"]
    },
    "parts": {
      "text": { "type": "text", "field": "text", "join": "\n" },
      "thinking": { "type": "reasoning", "field": "text", "join": "\n\n" },
      "compaction": { "type": "compaction", "rowTypeField": "type" },
      "tool": { "type": "tool", "nameField": "name", "fallbackName": "tool" },
      "file": {
        "type": "file",
        "nameField": "name",
        "fallbackName": "附件",
        "urlField": "data",
        "mimeField": "mime"
      }
    }
  },
  "partTimeKeys": { "start": "created", "end": "completed" },
  "endpoints": {
    "sessions": "/api/session",
    "session": "/api/session/{id}",
    "sessionMessages": "/api/session/{id}/message",
    "sessionPrompt": "/api/session/{id}/prompt",
    "sessionModel": "/api/session/{id}/model",
    "sessionFork": "/api/session/{id}/fork",
    "sessionAbort": "/api/session/{id}/interrupt",
    "sessionSummarize": "/api/session/{id}/compact",
    "projects": "/api/project",
    "providers": "/api/model",
    "events": "/api/event"
  },
  "events": {
    "refresh": [
      "session.created",
      "session.updated",
      "session.deleted",
      "session.renamed",
      "session.compacted",
      "message.updated",
      "message.removed"
    ],
    "ignore": [
      "session.inbox.enqueued",
      "session.inbox.delivered",
      "session.step.started",
      "session.step.streamed",
      "session.step.ended",
      "session.usage.updated",
      "session.model.selected",
      "session.instructions.updated",
      "project.updated",
      "mcp.status.changed",
      "mcp.resources.changed",
      "vcs.branch.updated",
      "agent.updated",
      "command.updated",
      "skill.updated",
      "integration.updated",
      "provider.updated",
      "model.updated",
      "server.connected"
    ],
    "idle": ["session.execution.succeeded", "session.execution.interrupted"],
    "error": { "name": "session.error", "detailPaths": ["error.message", "error.type"] },
    "sessionIdPaths": ["sessionID", "session.sessionID", "session.id", "part.sessionID"],
    "messageIdPaths": ["assistantMessageID", "messageID", "part.messageID"]
  }
}
